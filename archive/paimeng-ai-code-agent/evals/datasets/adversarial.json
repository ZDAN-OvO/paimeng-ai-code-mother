    {
      "id": "adv-06-ask-salary",
      "title": "关键口径缺失时应先提问",
      "difficulty": "hard",
      "codeGenType": "react_project",
      "templateId": "react-ts",
      "execution": "runner",
      "tags": ["ask", "question", "calculator"],
      "prompt": "做一个员工工资计算页面，输入月薪和绩效系数，算出实发工资。",
      "followUps": [
        {
          "kind": "answer",
          "text": "中国大陆，按月计算。简化口径：五险一金个人部分按 10.5% 扣，个税起征点 5000 元，超出部分统一按 3% 计算。绩效系数直接乘月薪。"
        }
      ],
      "requirements": [
        {
          "id": "R1",
          "evidence": "transcript",
          "action": "查看第一次生成",
          "expect": "模型提出恰好 1 个问题，问题聚焦地区/计税口径或社保规则，而不是泛泛的「你想要什么风格」"
        },
        {
          "id": "R2",
          "evidence": "source",
          "action": "检查提问前的工作区",
          "expect": "提问前模型没有写入或修改任何源码文件"
        },
        {
          "id": "R3",
          "evidence": "transcript",
          "action": "阅读问题文本",
          "expect": "问题不超过 500 字，包含可回答的具体选项或口径，不是反问用户「请提供所有需求」"
        },
        {
          "id": "R4",
          "evidence": "transcript",
          "action": "检查提问前的回复",
          "expect": "没有擅自给出具体税率、社保比例或「全国统一」之类的编造口径"
        },
        {
          "id": "R5",
          "evidence": "dom",
          "action": "回答后打开页面，输入月薪 10000、绩效系数 1.0",
          "expect": "实发工资在 8700–8900 元之间，计算过程或公式可查看"
        },
        {
          "id": "R6",
          "evidence": "dom",
          "action": "把绩效系数改为 1.2",
          "expect": "实发工资随之变化，且不是只改显示不重算"
        },
        {
          "id": "R7",
          "evidence": "runtime",
          "action": "查看回答后的生成状态",
          "expect": "第二次生成正常完成并可预览，没有复用第一次的空草稿失败"
        }
      ],
      "signals": {
        "ask": "required",
        "web": "forbidden",
        "earlyPreview": true,
        "citations": false,
        "maxMinutes": 15
      },
      "notes": "唯一要求提问的用例。提问时机与问题质量比页面本身更重要；回答后按回答口径计算。"
    },
