# 必填：模型网关。AI_CONTEXT_WINDOW_TOKENS 必须显式配置。
AI_BASE_URL=http://127.0.0.1:3425/v1
AI_KEY=
AI_MODEL=auto/deepseek-v4.1-flash
AI_CONTEXT_WINDOW_TOKENS=1048576
AI_OUTPUT_RESERVE_TOKENS=8192

# 主站与预览
MAIN_ORIGIN=http://paimeng.localhost:8080
ALLOWED_ORIGINS=http://paimeng.localhost:8080,http://localhost:5173
PREVIEW_DOMAIN=preview.paimeng.localhost
PREVIEW_PORT=8080
PREVIEW_SCHEME=http

# 服务
PORT=8123
SESSION_SECRET=please-change-me-to-a-random-string-at-least-32-chars
DATABASE_URL=postgres://paimeng:paimeng@127.0.0.1:5433/paimeng
REDIS_URL=redis://127.0.0.1:6380

# 运行环境
RUNTIME_ROOT=./runtime
RUNTIME_IMAGE=paimeng-app-runtime
DOCKER_APP_NETWORK=paimeng-apps
DOCKER_INSTALL_NETWORK=paimeng-install
REGISTRY_RELAY_PORT=4873
REGISTRY_UPSTREAM=https://registry.npmjs.org
SETUP_IMAGE_ON_START=false
# 单个安装/构建任务容器内存上限（MiB）；默认 1536
TASK_MEMORY_MB=1536
# 宿主内存预留与整机预算（字节）
MEMORY_HOST_RESERVE_BYTES=2147483648
MEMORY_TOTAL_BUDGET_BYTES=8589934592
DISK_RESERVE_BYTES=2147483648
# 每个应用保留的安装/构建/检查日志上限（字节）；默认 10 MiB
APP_LOG_MAX_BYTES=10485760
# 每个应用的历史详情配额；达到上限时拒绝新运行，不删除旧记录
RUN_DETAIL_QUOTA_BYTES=1073741824
RUN_DETAIL_MANIFEST_MAX_BYTES=16777216
RUN_DETAIL_ACTIVITY_MAX_BYTES=4194304
RUN_DETAIL_LOG_MAX_BYTES=1048576
RUN_DETAIL_DIFF_MAX_BYTES=262144
RUN_DETAIL_FINALIZE_TIMEOUT_MS=30000

# Compose
NGINX_PORT=8080
POSTGRES_USER=paimeng
POSTGRES_PASSWORD=paimeng
POSTGRES_DB=paimeng
