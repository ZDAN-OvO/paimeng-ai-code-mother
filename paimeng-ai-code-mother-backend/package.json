{
  "name": "paimeng-ai-code-mother-backend",
  "version": "0.1.0",
  "private": true,
  "description": "派蒙 AI 应用工坊后端（NestJS）",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && node dist/main.js",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:acceptance:concurrency": "node scripts/concurrency-acceptance.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "maintenance:purge-legacy": "tsx scripts/purge-legacy-apps.ts",
    "dev:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.141",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "@vscode/ripgrep": "1.18.0",
    "ai": "6.0.330",
    "connect-redis": "10.0.0",
    "drizzle-orm": "0.45.4",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "http-proxy": "1.18.1",
    "nestjs-zod": "5.6.0",
    "pg": "8.23.1",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semver": "7.8.6",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "11.2.9",
    "@types/express": "5.0.5",
    "@types/express-session": "1.19.0",
    "@types/http-proxy": "1.17.16",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/semver": "7.7.1",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
