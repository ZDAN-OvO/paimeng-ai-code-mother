{
  "name": "paimeng",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"docs/api.md\" \"*.md\" \"package.json\" \"tsconfig.json\" \"components.json\" \"*.config.{mjs,mts,ts}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"docs/api.md\" \"*.md\" \"package.json\" \"tsconfig.json\" \"components.json\" \"*.config.{mjs,mts,ts}\" \".github/**/*.yml\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db/migrate.ts",
    "pr:gate": "tsx scripts/pr-gate.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.90",
    "@vscode/ripgrep": "1.18.0",
    "ai": "7.0.169",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.548.0",
    "next": "^16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.19.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
